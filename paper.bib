% Source of the Keyes viscosity correlation used by lptlib. Bibliographic
% detail (author F. G. Keyes; Trans. Am. Soc. Mech. Engrs. 73, 589--596, 1951)
% confirmed from an indexed bibliography record, and consistent with the ASME
% Digital Collection record for J. Fluids Eng. 73(5):589 -- J. Fluids Eng. being
% the modern name of that Transactions series. The ASME page itself refuses
% automated retrieval. No DOI was found for this paper through any source, so
% none is given.
%
% Caveat, recorded deliberately: the correlation's three constants as coded
% (a0 = 1.488, a = 122.1, a1 = 5.0) were verified against NASA Glenn's Wind-US
% 3.0 documentation, which states the same formula in imperial units and calls
% it Keyes' law, NOT against the 1951 paper itself.
@article{keyes1951viscosity,
  author  = {Keyes, F. G.},
  title   = {A Summary of Viscosity and Heat-Conduction Data for {He}, {A}, {H2}, {O2}, {N2}, {CO}, {CO2}, {H2O}, and Air},
  journal = {Transactions of the ASME},
  year    = {1951},
  volume  = {73},
  number  = {5},
  pages   = {589--596}
}

